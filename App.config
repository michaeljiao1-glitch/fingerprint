<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <appSettings>
        <!-- Where patients and visits are stored. Empty = %ProgramData%\PatientCheckIn -->
        <add key="DataDirectory" value="" />
        <!-- How long the reader waits for a finger. -->
        <add key="ScanTimeoutSeconds" value="30" />
        <!-- A repeat scan of the same patient within this window is ignored (no accidental check-out). -->
        <add key="DuplicateScanWindowMinutes" value="2" />

        <!-- Cybermed integration (currently a placeholder client, see Services\CybermedClient.cs). -->
        <add key="Cybermed.Enabled" value="true" />
        <add key="Cybermed.BaseUrl" value="https://cybermed.example.com/api" />
        <add key="Cybermed.ApiKey" value="" />
    </appSettings>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="UranusCoreEndpoint" closeTimeout="Infinite" openTimeout="Infinite" receiveTimeout="Infinite" sendTimeout="Infinite" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:22966/Bayometric/BFSAPI/soap"
                binding="basicHttpBinding" bindingConfiguration="UranusCoreEndpoint"
                contract="UranusCoreAPIServiceReference.UranusCore" name="UranusCoreEndpoint" />
        </client>
    </system.serviceModel>
</configuration>
