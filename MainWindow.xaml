<Window x:Class="SampleApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="350" Width="598">
    <Grid>
        <Label Content="Biometric ID:" HorizontalAlignment="Left" Margin="5,20,0,0" VerticalAlignment="Top" FontSize="18"/>
        <TextBox x:Name="tbGuid" HorizontalAlignment="Left" Height="23" Margin="122,26,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="322"/>
        <Button x:Name="btRegisterPerson" Content="Register Person" HorizontalAlignment="Left" Margin="461,72,0,0" VerticalAlignment="Top" Width="108" Click="btRegisterPerson_Click"/>
        <Button x:Name="btUnregisterPerson" Content="Unregister Person" HorizontalAlignment="Left" Margin="461,97,0,0" VerticalAlignment="Top" Width="108" Click="btUnregisterPerson_Click"/>
        <Button x:Name="btSearch" Content="Search" HorizontalAlignment="Left" Margin="461,133,0,0" VerticalAlignment="Top" Width="108" Click="btSearch_Click"/>
        <Button x:Name="btCancelSearch" Content="Cancel  Search" HorizontalAlignment="Left" Margin="461,158,0,0" VerticalAlignment="Top" Width="108" Click="btCancelSearch_Click"/>
        <Button x:Name="btCreateSession" Content="Create Session" HorizontalAlignment="Left" Margin="461,17,0,0" VerticalAlignment="Top" Width="108" Click="btCreateSession_Click"/>
        <Button x:Name="btEndSession" Content="End Session" HorizontalAlignment="Left" Margin="461,42,0,0" VerticalAlignment="Top" Width="108" Click="btEndSession_Click"/>
        <Button x:Name="btListUsers" Content="List Users" HorizontalAlignment="Left" Margin="10,163,0,0" VerticalAlignment="Top" Width="108" Click="btListUsers_Click"/>
        <ListBox x:Name="lbUsers" HorizontalAlignment="Left" Height="146" Margin="135,163,0,0" VerticalAlignment="Top" Width="178"/>

    </Grid>
</Window>
