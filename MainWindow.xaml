<Window x:Class="SampleApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient Check-In" Height="620" Width="980" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Button x:Name="btScan" Content="Scan Fingerprint" FontSize="22" Padding="28,16" Click="btScan_Click"/>
                <Button x:Name="btCancelScan" Content="Cancel Scan" Margin="0,6,0,0" IsEnabled="False" Click="btCancelScan_Click"/>
            </StackPanel>

            <Border x:Name="bdStatus" Grid.Column="1" Margin="16,0" Padding="14,10"
                    BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Background="#F5F5F5">
                <StackPanel>
                    <TextBlock x:Name="tbStatusTitle" FontSize="26" FontWeight="SemiBold" Text="Ready"/>
                    <TextBlock x:Name="tbStatusDetail" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Press Scan Fingerprint and ask the patient to place their finger on the reader."/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Button x:Name="btPatients" Content="Manage Patients..." Click="btPatients_Click"/>
            </StackPanel>
        </Grid>

        <DockPanel DockPanel.Dock="Top" Margin="0,14,0,6" LastChildFill="False">
            <TextBlock Text="Visits on" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <DatePicker x:Name="dpDay" Width="140" SelectedDateChanged="dpDay_SelectedDateChanged"/>
            <TextBlock x:Name="tbSummary" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555555"/>
            <Button DockPanel.Dock="Right" x:Name="btRetrySync" Content="Retry Cybermed Sync" Margin="6,0,0,0" Click="btRetrySync_Click"/>
            <Button DockPanel.Dock="Right" x:Name="btCheckOut" Content="Check Out Selected" Click="btCheckOut_Click"/>
        </DockPanel>

        <DataGrid x:Name="dgVisits" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*"/>
                <DataGridTextColumn Header="Arrived" Binding="{Binding Arrived}" Width="90"/>
                <DataGridTextColumn Header="Left" Binding="{Binding Left}" Width="90"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90"/>
                <DataGridTextColumn Header="Cybermed Visit" Binding="{Binding CybermedVisitId}" Width="*"/>
                <DataGridTextColumn Header="Cybermed Status" Binding="{Binding CybermedStatus}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
