<Window x:Class="SampleApplication.PatientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patients" Height="520" Width="860" MinHeight="320" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="tbFilter" TextChanged="tbFilter_TextChanged" VerticalContentAlignment="Center" Height="24"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <Button x:Name="btEnroll" Content="Enroll New Patient..." Click="btEnroll_Click"/>
            <Button x:Name="btEdit" Content="Edit Details..." Margin="6,0,0,0" Click="btEdit_Click"/>
            <Button x:Name="btRemove" Content="Remove Patient" Margin="6,0,0,0" Click="btRemove_Click"/>
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="btClose_Click"/>
            <TextBlock x:Name="tbBusy" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555555"/>
        </DockPanel>

        <DataGrid x:Name="dgPatients" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  MouseDoubleClick="dgPatients_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="Date of Birth" Binding="{Binding DateOfBirthText}" Width="100"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*"/>
                <DataGridTextColumn Header="Cybermed ID" Binding="{Binding CybermedPatientId}" Width="*"/>
                <DataGridCheckBoxColumn Header="Fingerprint" Binding="{Binding HasFingerprint, Mode=OneWay}" Width="80"/>
                <DataGridTextColumn Header="Enrolled" Binding="{Binding EnrolledAt, StringFormat=d}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
